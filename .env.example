# AI & LLM Providers (Google Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-2

# External Public Search (Fallback)
TAVILY_API_KEY=your_tavily_api_key_here

# Cloud Vector Storage (Pinecone Serverless)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=enterprise-hr-policy-agentic-rag
PINECONE_NAMESPACE=company-hr-kb

# JWT Authentication (Never commit actual secrets)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Demo User Credentials (Injected via environment variables)
DEMO_USER_USERNAME=
DEMO_USER_PASSWORD=
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=

# Application Environment
APP_ENV=development
